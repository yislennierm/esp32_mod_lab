# ESP-IDF location. Use one of these.
# macOS example:
# IDF_PATH=/Users/nene/esp/v5.5/esp-idf
# Linux example:
# IDF_PATH=/home/your-user/esp/v5.5/esp-idf
# Direct export script override:
# IDF_EXPORT=/absolute/path/to/esp-idf/export.sh

# Native ESP32-P4 USB Serial/JTAG app/data port.
# macOS example:
# PORT=/dev/cu.usbmodem14401
# Linux examples:
# PORT=/dev/ttyACM0
# PORT=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*

# Optional WCH UART recovery/flashing port.
# macOS example:
# RECOVERY_PORT=/dev/cu.wchusbserial5A470211841
# Linux examples:
# RECOVERY_PORT=/dev/ttyUSB0
# RECOVERY_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-*

LISTEN_PORT=8791
BUILD_DIR=build_esp32p4
